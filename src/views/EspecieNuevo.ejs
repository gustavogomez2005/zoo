<H1>INGRESAR UNA NUEVA ESPECIE</H1>

  <form action="/especie/nuevo" method="post">
    <div class="input-group">
      <span class="input-group-text">Código de Especie</span>
      <input type="text" name="id" size="14" maxlength="11" id="id" placeholder="Ingrese el id de la especie" aria-label="First name" class="form-control"><br><br>
    </div><br>
    <div class="input-group">
      <span class="input-group-text">Nombre Científico</span>
      <input type="text" name="nom" size="40" maxlength="35" id="nom" placeholder="Nombre Científico" aria-label="First name" class="form-control"><br><br>
    </div><br>
    <div class="input-group">
      <span class="input-group-text">Familia</span>
      <input type="text" name="fam" size="30" maxlength="25" id="fam" placeholder="a que familia pertenece" aria-label="First name" class="form-control"><br><br>
    </div><br>
    <div class="input-group">
      <span class="input-group-text">En extinsión ?</span>
          <input class="form-check-input mt-100" type="checkbox" value="1" name="ext" id="ext" aria-label="Checkbox for following text input"><br><br>
    </div><br><br>
    
    <button type="submit" class="btn btn-primary">INGRESAR</button>
    <button type="reset" class="btn btn-danger">CANCELAR</button>
  </form>

</body>
</html>