<!-- <form action="/zoo/buscaid/:id" method="get"> -->
<form onsubmit="tomaElValorPorParametro(event)"> 
  <div class="mb-3">
    <label for="txtid" class="form-label">Ingrese su Id: </label>
    <input type="text" class="form-control" id="txtid" name="id" aria-describedby="emailHelp">
  </div>
  <button type="submit" class="btn btn-primary">BUSCAR</button>
  <button type="reset" class="btn btn-danger">CANCELAR</button>
</form>

<script>
  function tomaElValorPorParametro(event) {
    event.preventDefault();
    let id = document.getElementById('txtid').value;
    window.location.href = `/zoo/buscaid/${id}`
    document.getElementById('txtid').value = '';
  }
</script>

